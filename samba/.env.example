# One block per person: ACCOUNT_<username>=<password>
# alekspi must keep UID 1000, the owner of /mnt/storage on the Pi
# Every account needs an explicit, unique UID: without one, an account can
# be given 1000 first, and then alekspi can't be created at all
ACCOUNT_alekspi="password"
UID_alekspi=1000
GROUPS_alekspi=smbusers

# Rename "partner" to username (lowercase)
ACCOUNT_partner="password"
UID_partner=1001
GROUPS_partner=smbusers
