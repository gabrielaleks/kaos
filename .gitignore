.env
letsencrypt

# Home Assistant - exclude sensitive and generated files
homeassistant/ha-config/secrets.yaml
homeassistant/ha-config/*.log*
homeassistant/ha-config/*.db*
homeassistant/ha-config/.storage/
homeassistant/ha-config/deps/
homeassistant/ha-config/tts/
homeassistant/ha-config/.HA_VERSION
homeassistant/ha-config/.cloud/
homeassistant/ha-config/.google.token
homeassistant/ha-config/known_devices.yaml
homeassistant/ha-config/home-assistant_v2.db*
homeassistant/ha-config/OZW_Log.txt
homeassistant/ha-config/zwcfg_*.xml
homeassistant/ha-config/ip_bans.yaml
homeassistant/ha-config/.ha_run.lock
homeassistant/matter-data

# Nanomatter
nanomatter/db
nanomatter/controller

# Envelope
envelope/mosquitto/config/passwd
envelope/mosquitto/data
envelope/mosquitto/log

# Backrest (config.json holds the repository password and B2 keys)
backrest/data
backrest/config
backrest/cache

# Other
.claude
.DS_Store